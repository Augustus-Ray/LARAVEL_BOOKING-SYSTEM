    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Cart functionality
        let currentPaymentData = null;

        function payNow(bookingId) {
            // Prepare single booking payment
            currentPaymentData = {
                type: 'single',
                bookings: [{
                    type: 'hotel',
                    id: bookingId,
                    amount: 0 // Will be calculated
                }]
            };

            // Calculate amount for this booking
            @if(isset($bookings))
                @foreach($bookings as $booking)
                    if ({{ $booking->id }} === bookingId) {
                        currentPaymentData.bookings[0].amount = {{ $booking->total_price }};
                        currentPaymentData.bookings[0].name = '{{ $booking->hotel->name }}';
                    }
                @endforeach
            @endif

            showPaymentModal();
        }

        function payAllBookings() {
            // Collect all pending booking data
            const pendingBookings = [];
            @if(isset($bookings))
                @foreach($bookings as $booking)
                    @if($booking->status === 'pending')
                        pendingBookings.push({
                            type: 'hotel',
                            id: {{ $booking->id }},
                            amount: {{ $booking->total_price }},
                            name: '{{ $booking->hotel->name }}'
                        });
                    @endif
                @endforeach
            @endif

            currentPaymentData = {
                type: 'bulk',
                bookings: pendingBookings
            };

            showPaymentModal();
        }

        function showPaymentModal() {
            if (!currentPaymentData || currentPaymentData.bookings.length === 0) {
                alert('No bookings to pay for.');
                return;
            }

            // Update payment summary
            let summaryHtml = '';
            let totalAmount = 0;

            currentPaymentData.bookings.forEach(booking => {
                summaryHtml += `
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small">${booking.name}</span>
                        <span class="small">$${booking.amount.toFixed(2)}</span>
                    </div>
                `;
                totalAmount += booking.amount;
            });

            document.getElementById('payment-summary-content').innerHTML = summaryHtml;
            document.getElementById('payment-total').textContent = `$${totalAmount.toFixed(2)}`;
            document.getElementById('payment-btn-amount').textContent = `$${totalAmount.toFixed(2)}`;

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('paymentModal'));
            modal.show();
        }

        function removeFromCart(bookingId) {
            if (confirm('Are you sure you want to remove this booking from your cart?')) {
                // Create a form for DELETE request
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/hotel-bookings/${bookingId}`;
                
                // Add CSRF token
                const csrfToken = document.createElement('input');
                csrfToken.type = 'hidden';
                csrfToken.name = '_token';
                csrfToken.value = '{{ csrf_token() }}';
                form.appendChild(csrfToken);
                
                // Add method override for DELETE
                const methodInput = document.createElement('input');
                methodInput.type = 'hidden';
                methodInput.name = '_method';
                methodInput.value = 'DELETE';
                form.appendChild(methodInput);
                
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Payment modal functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-refresh cart badge
            const cartItems = document.querySelectorAll('.cart-item').length;
            const cartBadges = document.querySelectorAll('.cart-badge');
            
            cartBadges.forEach(badge => {
                if (cartItems > 0) {
                    badge.textContent = cartItems;
                    badge.style.display = 'flex';
                } else {
                    badge.style.display = 'none';
                }
            });

            // Card number formatting
            document.getElementById('cardNumber').addEventListener('input', function(e) {
                let value = e.target.value.replace(/\s/g, '').replace(/[^0-9]/gi, '');
                let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
                e.target.value = formattedValue;
            });

            // Expiry date formatting
            document.getElementById('expiryDate').addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length >= 2) {
                    value = value.substring(0, 2) + '/' + value.substring(2, 4);
                }
                e.target.value = value;
            });

            // CVV validation
            document.getElementById('cvv').addEventListener('input', function(e) {
                e.target.value = e.target.value.replace(/[^0-9]/g, '');
            });

            // Process payment button
            document.getElementById('processPaymentBtn').addEventListener('click', function() {
                const btn = this;
                const spinner = document.getElementById('paymentSpinner');
                
                // Show loading state
                btn.disabled = true;
                spinner.classList.remove('d-none');
                btn.innerHTML = `<i class="fas fa-lock me-2"></i><span class="spinner-border spinner-border-sm me-2"></span>Processing...`;

                // Simulate payment processing delay
                setTimeout(() => {
                    processActualPayment();
                }, 2000);
            });
        });

        function processActualPayment() {
            if (!currentPaymentData) return;

            if (currentPaymentData.type === 'single') {
                // Process single payment
                const booking = currentPaymentData.bookings[0];
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/process-payment/hotel/${booking.id}`;
                
                // Add CSRF token
                const csrfToken = document.createElement('input');
                csrfToken.type = 'hidden';
                csrfToken.name = '_token';
                csrfToken.value = '{{ csrf_token() }}';
                form.appendChild(csrfToken);
                
                document.body.appendChild(form);
                form.submit();
            } else {
                // Process bulk payment
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/process-all-payments';
                
                // Add CSRF token
                const csrfToken = document.createElement('input');
                csrfToken.type = 'hidden';
                csrfToken.name = '_token';
                csrfToken.value = '{{ csrf_token() }}';
                form.appendChild(csrfToken);
                
                // Add bookings data
                const bookingsInput = document.createElement('input');
                bookingsInput.type = 'hidden';
                bookingsInput.name = 'bookings';
                bookingsInput.value = JSON.stringify(currentPaymentData.bookings);
                form.appendChild(bookingsInput);
                
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>
